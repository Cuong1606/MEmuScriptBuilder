<Window x:Class="MEmuScriptStudio.App.SwipeCaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        ResizeMode="NoResize" IsHitTestVisible="False">
    <Canvas x:Name="OverlayCanvas" ClipToBounds="True">
        <Border Canvas.Left="12" Canvas.Top="12" Padding="10,7" Background="#DD111827"
                BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="5">
            <TextBlock x:Name="InstructionText" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="13"
                       Text="Chuột trái: điểm đầu  •  Chuột phải: điểm cuối  •  Enter: xác nhận  •  Esc: hủy" />
        </Border>
        <Line x:Name="SwipeLineOutline" Stroke="#FF020617" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
        <Line x:Name="SwipeLine" Stroke="#FFF8FAFC" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
        <Polygon x:Name="ArrowHeadOutline" Fill="#FF020617" Visibility="Collapsed" />
        <Polygon x:Name="ArrowHead" Fill="#FFF8FAFC" Visibility="Collapsed" />

        <Ellipse x:Name="StartMarker" Width="8" Height="8" Fill="#FF22D3EE" Stroke="#FF020617" StrokeThickness="2" Visibility="Collapsed" />
        <Border x:Name="StartLabel" Padding="4,2" Background="#F2020617" BorderBrush="#FF22D3EE" BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
            <TextBlock x:Name="StartLabelText" Foreground="White" FontSize="11" FontWeight="SemiBold" />
        </Border>

        <Ellipse x:Name="EndMarker" Width="8" Height="8" Fill="#FFFBBF24" Stroke="#FF020617" StrokeThickness="2" Visibility="Collapsed" />
        <Border x:Name="EndLabel" Padding="4,2" Background="#F2020617" BorderBrush="#FFFBBF24" BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
            <TextBlock x:Name="EndLabelText" Foreground="White" FontSize="11" FontWeight="SemiBold" />
        </Border>
    </Canvas>
</Window>
