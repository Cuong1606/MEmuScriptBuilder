<Window x:Class="MEmuScriptStudio.App.SwipeCaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        ResizeMode="NoResize" IsHitTestVisible="False">
    <Canvas x:Name="OverlayCanvas" ClipToBounds="True">
        <Border Canvas.Left="12" Canvas.Top="12" Padding="10,7" Background="#DD111827"
                BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="5">
            <TextBlock Foreground="White" FontFamily="Segoe UI Semibold" FontSize="13"
                       Text="Chuột trái: điểm đầu  •  Chuột phải: điểm cuối  •  Enter: xác nhận  •  Esc: hủy" />
        </Border>
        <Line x:Name="SwipeLine" Stroke="#FFF8FAFC" StrokeThickness="3" StrokeDashArray="5,2" Visibility="Collapsed" />
        <Polygon x:Name="ArrowHead" Fill="#FFF8FAFC" Visibility="Collapsed" />

        <Ellipse x:Name="StartMarker" Width="22" Height="22" Fill="#DD2563EB" Stroke="White" StrokeThickness="3" Visibility="Collapsed" />
        <Border x:Name="StartLabel" Padding="7,4" Background="#EE1E3A8A" CornerRadius="4" Visibility="Collapsed">
            <TextBlock x:Name="StartLabelText" Foreground="White" FontWeight="SemiBold" />
        </Border>

        <Ellipse x:Name="EndMarker" Width="22" Height="22" Fill="#DDEA580C" Stroke="White" StrokeThickness="3" Visibility="Collapsed" />
        <Border x:Name="EndLabel" Padding="7,4" Background="#EE9A3412" CornerRadius="4" Visibility="Collapsed">
            <TextBlock x:Name="EndLabelText" Foreground="White" FontWeight="SemiBold" />
        </Border>
    </Canvas>
</Window>
