<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Version>1.2.1</Version>
    <Product>MEmu Script Studio</Product>
    <AssemblyTitle>MEmu Script Studio</AssemblyTitle>
    <Description>Ứng dụng Windows cục bộ để tạo và thực thi kịch bản trên thiết bị MEmu và Android.</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <ProjectReference Include="..\MEmuScriptStudio.Core\MEmuScriptStudio.Core.csproj" />
    <ProjectReference Include="..\MEmuScriptStudio.Infrastructure\MEmuScriptStudio.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MEmuScriptStudio.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Content Include="..\..\HUONG-DAN-SU-DUNG.md"
             Link="HUONG-DAN-SU-DUNG.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\adb\**\*"
             Link="tools\adb\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
