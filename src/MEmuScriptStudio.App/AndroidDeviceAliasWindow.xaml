<Window x:Class="MEmuScriptStudio.App.AndroidDeviceAliasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi tên thiết bị Android" Width="460" SizeToContent="Height"
        MinWidth="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="Assets/AppIcon.ico" Background="{StaticResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Alias chỉ đổi tên hiển thị; serial ADB vẫn là định danh thực thi."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Grid.Row="2" x:Name="SerialTextBlock" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4">
            <TextBlock Text="Tên thiết bị" />
            <TextBox x:Name="AliasTextBox" Margin="0,4,0,0" MaxLength="80"
                     AutomationProperties.Name="Tên thiết bị Android" />
        </StackPanel>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Xóa alias" Click="Remove_Click" MinWidth="90" />
            <Button Grid.Column="2" Content="Hủy" IsCancel="True" MinWidth="90" />
            <Button Grid.Column="4" Content="Lưu" Click="Save_Click" IsDefault="True" MinWidth="90" />
        </Grid>
    </Grid>
</Window>
