<UserControl x:Class="MEmuScriptStudio.App.Controls.DurationInputControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left">
    <UserControl.Resources>
        <Style x:Key="DurationPartTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorInkBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HoursTextBox" Grid.Column="0" MaxLength="3"
                     Style="{StaticResource DurationPartTextBoxStyle}"
                     Tag="{Binding HoursHasError, ElementName=Root}"
                     ToolTip="{Binding ValidationMessage, ElementName=Root}"
                     AutomationProperties.Name="Giờ" />
            <TextBlock Grid.Column="1" Text="giờ" Margin="3,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="MinutesTextBox" Grid.Column="2" MaxLength="2"
                     Style="{StaticResource DurationPartTextBoxStyle}"
                     Tag="{Binding MinutesHasError, ElementName=Root}"
                     ToolTip="{Binding ValidationMessage, ElementName=Root}"
                     AutomationProperties.Name="Phút" />
            <TextBlock Grid.Column="3" Text="phút" Margin="3,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="SecondsTextBox" Grid.Column="4" MaxLength="2"
                     Style="{StaticResource DurationPartTextBoxStyle}"
                     Tag="{Binding SecondsHasError, ElementName=Root}"
                     ToolTip="{Binding ValidationMessage, ElementName=Root}"
                     AutomationProperties.Name="Giây" />
            <TextBlock Grid.Column="5" Text="giây" Margin="3,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="MillisecondsTextBox" Grid.Column="6" Width="46" MaxLength="3"
                     Style="{StaticResource DurationPartTextBoxStyle}"
                     Tag="{Binding MillisecondsHasError, ElementName=Root}"
                     ToolTip="{Binding ValidationMessage, ElementName=Root}"
                     AutomationProperties.Name="Mili giây" />
            <TextBlock Grid.Column="7" Text="ms" Margin="3,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding ValidationMessage, ElementName=Root}"
                   Foreground="{StaticResource ErrorInkBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInputValid, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
