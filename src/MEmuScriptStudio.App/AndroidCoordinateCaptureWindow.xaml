<Window x:Class="MEmuScriptStudio.App.AndroidCoordinateCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lấy tọa độ Android" Width="820" Height="700" MinWidth="620" MinHeight="480"
        Icon="Assets/AppIcon.ico" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="DeviceText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InstructionText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="Làm mới ảnh" Click="Refresh_Click"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="112"
                    AutomationProperties.Name="Làm mới ảnh chụp Android" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8" ClipToBounds="True">
            <Grid x:Name="ImageHost">
                <Image x:Name="ScreenshotImage" Stretch="Uniform" SnapsToDevicePixels="True"
                       MouseLeftButtonDown="Screenshot_MouseLeftButtonDown"
                       MouseMove="Screenshot_MouseMove"
                       MouseLeftButtonUp="Screenshot_MouseLeftButtonUp"
                       SizeChanged="Screenshot_SizeChanged" />
                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                    <Line x:Name="SwipeLine" Stroke="{StaticResource FocusBrush}" StrokeThickness="3" Visibility="Collapsed" />
                    <Ellipse x:Name="StartMarker" Width="12" Height="12" Fill="{StaticResource FocusBrush}"
                             Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
                    <Ellipse x:Name="EndMarker" Width="12" Height="12" Fill="{StaticResource DangerBrush}"
                             Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" IsCancel="True" MinWidth="90" />
            <Button x:Name="UseButton" Content="Dùng tọa độ" Click="Use_Click" IsDefault="True"
                    IsEnabled="False" MinWidth="112" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
