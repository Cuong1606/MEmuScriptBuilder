<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TabStyle" TargetType="TabItem">
        <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,7"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SharedFocusVisualStyle}"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Background" Value="{StaticResource SelectedBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource TabStyle}"/>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="2"/></Style>
</ResourceDictionary>
