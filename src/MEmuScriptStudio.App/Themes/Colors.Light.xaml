<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#F3F6F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EAF0F4</Color>
    <Color x:Key="TextPrimaryColor">#16232D</Color>
    <Color x:Key="TextSecondaryColor">#475866</Color>
    <Color x:Key="BorderColor">#C8D3DB</Color>
    <Color x:Key="PrimaryColor">#CFEAF5</Color>
    <Color x:Key="PrimaryHoverColor">#B8DFEF</Color>
    <Color x:Key="PrimaryPressedColor">#9ED2E6</Color>
    <Color x:Key="OnPrimaryColor">#08354A</Color>
    <Color x:Key="SelectedColor">#D9EEF7</Color>
    <Color x:Key="SelectedTextColor">#08354A</Color>
    <Color x:Key="FocusColor">#C2410C</Color>
    <Color x:Key="DangerColor">#B42318</Color>
    <Color x:Key="DangerHoverColor">#941D13</Color>
    <Color x:Key="OnDangerColor">#FFFFFF</Color>
    <Color x:Key="DisabledSurfaceColor">#E2E8EC</Color>
    <Color x:Key="DisabledTextColor">#6B7780</Color>
    <Color x:Key="SuccessSurfaceColor">#DDF4E8</Color>
    <Color x:Key="SuccessTextColor">#146C43</Color>
    <Color x:Key="WarningSurfaceColor">#FFF1CC</Color>
    <Color x:Key="WarningTextColor">#7A4200</Color>
    <Color x:Key="ErrorSurfaceColor">#FDE7E5</Color>
    <Color x:Key="ErrorTextColor">#962016</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="SelectedInkBrush" Color="{StaticResource SelectedTextColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerInkBrush" Color="{StaticResource OnDangerColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledSurfaceColor}" />
    <SolidColorBrush x:Key="DisabledInkBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessInkBrush" Color="{StaticResource SuccessTextColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="WarningInkBrush" Color="{StaticResource WarningTextColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorSurfaceColor}" />
    <SolidColorBrush x:Key="ErrorInkBrush" Color="{StaticResource ErrorTextColor}" />
    <SolidColorBrush x:Key="ConsoleBrush" Color="#11181D" />
    <SolidColorBrush x:Key="ConsolePanelBrush" Color="#182229" />
    <SolidColorBrush x:Key="ConsoleInkBrush" Color="#F3F7F9" />
    <SolidColorBrush x:Key="ConsoleMutedBrush" Color="#B7C4CC" />
    <SolidColorBrush x:Key="ConsoleSelectedBrush" Color="#234C60" />
</ResourceDictionary>
