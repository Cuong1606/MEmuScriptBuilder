<UserControl x:Class="MEmuScriptStudio.App.Views.ExecutionHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="3*" /><RowDefinition Height="10" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource GroupCardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="Lịch sử trong phiên" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Right" Text="Tối đa 100 nhóm gần nhất" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding ExecutionHistory}" SelectedItem="{Binding SelectedHistoryGroup, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nhóm" Binding="{Binding DisplayName}" Width="90" />
                        <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartedAt, StringFormat={}{0:HH:mm:ss}}" Width="100" />
                        <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndedAt, StringFormat={}{0:HH:mm:ss}}" Width="100" />
                        <DataGridTextColumn Header="Kịch bản" Binding="{Binding ScriptSummary}" Width="*" />
                        <DataGridTextColumn Header="Kết quả" Binding="{Binding StatusText}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="4">
                    <Button Content="Xóa mục đã chọn" Command="{Binding DeleteSelectedHistoryCommand}" Style="{StaticResource DangerButtonStyle}" />
                    <Button Content="Xóa các nhóm đã hoàn tất" Command="{Binding DeleteCompletedHistoryCommand}" Style="{StaticResource DangerButtonStyle}" />
                    <Button Content="Xóa toàn bộ lịch sử" Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButtonStyle}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Chi tiết nhóm" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="ID kỹ thuật: " /><Run Text="{Binding SelectedHistoryGroup.TechnicalId, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedHistoryGroup.Instances}" SelectedItem="{Binding SelectedHistoryInstance, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="55" />
                            <DataGridTextColumn Header="Giả lập" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Kịch bản" Binding="{Binding ScriptName}" Width="*" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Log đã lưu" FontWeight="SemiBold" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding HistoryExecutionLog}" FontFamily="Consolas" FontSize="12" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
