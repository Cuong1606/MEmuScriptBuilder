<UserControl x:Class="MEmuScriptStudio.App.Views.RunControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Thiết lập chạy" FontSize="18" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,8,0,8">
                            <RadioButton Content="Một kịch bản cho tất cả" IsChecked="{Binding IsOneScriptForAll}" GroupName="CenterAssignment" Margin="0,0,14,6" />
                            <RadioButton Content="Mỗi giả lập một kịch bản" IsChecked="{Binding IsPerInstanceScript}" GroupName="CenterAssignment" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding IsOneScriptForAll, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Kịch bản dùng chung" FontWeight="SemiBold" />
                            <ComboBox x:Name="CommonScriptComboBox" ItemsSource="{Binding Scripts}" SelectedItem="{Binding CommonRunScript, Mode=TwoWay}"
                                      DisplayMemberPath="Name" Margin="0,5,0,8"
                                      AutomationProperties.Name="Kịch bản dùng chung" />
                        </StackPanel>
                        <TextBlock Text="{Binding RunConfigurationError}" Foreground="{StaticResource ErrorInkBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GroupCardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Giả lập mục tiêu" FontSize="16" FontWeight="SemiBold" />
                        <ListBox x:Name="RunTargetsList" ItemsSource="{Binding RunTargets}" MaxHeight="300" Margin="0,6,0,0"
                                 ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="Danh sách chọn giả lập chạy">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="1,2">
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Index, StringFormat=\#{0}}" FontFamily="Consolas" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Text="{Binding AvailabilityText}" Foreground="{StaticResource MutedBrush}" />
                                            </Grid>
                                        </CheckBox>
                                        <ComboBox Margin="24,4,0,0" ItemsSource="{Binding DataContext.Scripts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AssignedScriptId, Mode=TwoWay}"
                                                  Visibility="{Binding DataContext.IsPerInstanceScript, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  AutomationProperties.Name="Kịch bản riêng của giả lập" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Visibility="{Binding IsPerInstanceScript, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                            <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding BulkAssignmentScript}" DisplayMemberPath="Name"
                                      AutomationProperties.Name="Kịch bản gán hàng loạt" />
                            <WrapPanel Margin="0,5,0,0">
                                <Button x:Name="AssignScriptToSelectedButton" Content="Gán cho mục đã chọn" Command="{Binding AssignScriptToSelectedCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button x:Name="AssignSelectedScriptToAllButton" Content="Gán kịch bản đang chọn cho tất cả" Command="{Binding AssignCurrentScriptToAllCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GroupCardStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Khoảng cách khởi chạy trong nhóm" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,0">
                            <RadioButton Content="Cố định (ms)" IsChecked="{Binding IsFixedSpacing}" GroupName="CenterSpacing" Margin="0,0,8,6" />
                            <TextBox Width="86" Text="{Binding FixedSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsFixedSpacing}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <RadioButton Content="Ngẫu nhiên (ms)" IsChecked="{Binding IsRandomSpacing}" GroupName="CenterSpacing" Margin="0,0,8,6" />
                            <TextBox Width="74" Text="{Binding RandomMinimumSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRandomSpacing}" />
                            <TextBlock Text="–" Margin="6,8" />
                            <TextBox Width="74" Text="{Binding RandomMaximumSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRandomSpacing}" />
                        </WrapPanel>
                        <CheckBox Content="Dừng cả nhóm nếu có giả lập không hợp lệ" IsChecked="{Binding StopAllOnInvalidTarget}" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="RunSelectedButton" Content="Chạy mục đã chọn" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button x:Name="RunAllRemainingButton" Content="Chạy tất cả còn lại" Command="{Binding RunAllRemainingCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Dừng tất cả" Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="3*" /><RowDefinition Height="10" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource GroupCardStyle}" Padding="10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dừng tất cả" Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" />
                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock><Run Text="Đang chạy  " /><Run Text="{Binding RunningInstanceCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock></Border>
                        <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock><Run Text="Chờ  " /><Run Text="{Binding WaitingInstanceCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock></Border>
                        <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock><Run Text="Nhóm  " /><Run Text="{Binding ActiveLaunchGroupCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock></Border>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <ListBox x:Name="ActiveLaunchGroupsList" Grid.Row="2" ItemsSource="{Binding ActiveLaunchGroups}" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GroupCardStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Dừng nhóm này"
                                                Command="{Binding DataContext.StopGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding LaunchGroupId}" Style="{StaticResource DangerButtonStyle}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ScriptSummary, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid Grid.Row="2" ItemsSource="{Binding Instances}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="260"
                                              SelectedItem="{Binding DataContext.SelectedInstanceRun, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="Auto" />
                                            <DataGridTextColumn Header="Giả lập" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Kịch bản" Binding="{Binding ScriptName}" Width="2*" />
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="2*" />
                                            <DataGridTextColumn Header="Bước" Binding="{Binding CurrentStep}" Width="*" />
                                            <DataGridTemplateColumn Header="" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Dừng" Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="4" Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Log của giả lập đang chọn" FontWeight="SemiBold" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding ExecutionLog}" FontFamily="Consolas" FontSize="12" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
