<UserControl x:Class="MEmuScriptStudio.App.Views.RunControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Kịch bản theo giả lập" FontFamily="Segoe UI Semibold" FontSize="16" />
                <WrapPanel Margin="0,6,0,10">
                    <RadioButton Content="Một kịch bản cho tất cả" IsChecked="{Binding IsOneScriptForAll}" GroupName="CenterAssignment" Margin="0,0,12,4"/>
                    <RadioButton Content="Mỗi giả lập một kịch bản" IsChecked="{Binding IsPerInstanceScript}" GroupName="CenterAssignment"/>
                </WrapPanel>
                <ListBox ItemsSource="{Binding RunTargets, Mode=OneWay}" MaxHeight="260" AutomationProperties.Name="Danh sách chọn thao tác chạy">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="Chọn giả lập cho thao tác">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Index, Mode=OneWay, StringFormat=\#\{0\}}" Width="46" FontFamily="Consolas"/>
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" Width="170"/>
                                        <TextBlock Text="{Binding AvailabilityText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                                <ComboBox Margin="24,4,0,0" MinHeight="30" ItemsSource="{Binding DataContext.Scripts, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AssignedScriptId, Mode=TwoWay}"
                                          Visibility="{Binding DataContext.IsPerInstanceScript, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          AutomationProperties.Name="Kịch bản riêng của giả lập"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Visibility="{Binding IsPerInstanceScript, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,4">
                    <ComboBox ItemsSource="{Binding Scripts, Mode=OneWay}" SelectedItem="{Binding BulkAssignmentScript}" DisplayMemberPath="Name" MinHeight="34" AutomationProperties.Name="Kịch bản gán hàng loạt"/>
                    <WrapPanel Margin="0,5,0,0">
                        <Button Content="Gán cho mục đã chọn" Command="{Binding AssignScriptToSelectedCommand}" Margin="0,0,6,4"/>
                        <Button Content="Gán kịch bản hiện tại cho tất cả" Command="{Binding AssignCurrentScriptToAllCommand}"/>
                    </WrapPanel>
                </StackPanel>
                <TextBlock Text="Khoảng cách khởi chạy trong từng nhóm" FontFamily="Segoe UI Semibold" Margin="0,8,0,4"/>
                <WrapPanel>
                    <RadioButton Content="Cố định (ms)" IsChecked="{Binding IsFixedSpacing}" GroupName="CenterSpacing" Margin="0,0,8,4"/>
                    <TextBox Width="80" Text="{Binding FixedSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsFixedSpacing, Mode=OneWay}"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <RadioButton Content="Ngẫu nhiên (ms)" IsChecked="{Binding IsRandomSpacing}" GroupName="CenterSpacing" Margin="0,0,8,4"/>
                    <TextBox Width="74" Text="{Binding RandomMinimumSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRandomSpacing, Mode=OneWay}"/>
                    <TextBlock Text="–" Margin="6,7"/><TextBox Width="74" Text="{Binding RandomMaximumSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRandomSpacing, Mode=OneWay}"/>
                </WrapPanel>
                <CheckBox Content="Dừng cả nhóm nếu có giả lập không hợp lệ" IsChecked="{Binding StopAllOnInvalidTarget}" Margin="0,8,0,4"/>
                <TextBlock Text="{Binding RunConfigurationError, Mode=OneWay}" Foreground="#B42318" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Chạy mục đã chọn" Command="{Binding RunCommand}" Background="{StaticResource AccentBrush}" Foreground="White" Margin="0,0,6,4"/>
                    <Button Content="Chạy tất cả còn lại" Command="{Binding RunAllRemainingCommand}" Margin="0,0,6,4"/>
                    <Button Content="Dừng nhóm đã chọn" Command="{Binding StopSelectedGroupCommand}" Margin="0,0,6,4"/>
                    <Button Content="Dừng tất cả nhóm" Command="{Binding StopCommand}"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Padding="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Đang chạy: "/><TextBlock Text="{Binding RunningInstanceCount, Mode=OneWay}" FontFamily="Segoe UI Semibold"/>
                    <TextBlock Text="   Chờ khởi chạy: "/><TextBlock Text="{Binding WaitingInstanceCount, Mode=OneWay}" FontFamily="Segoe UI Semibold"/>
                    <TextBlock Text="   Nhóm: "/><TextBlock Text="{Binding ActiveLaunchGroupCount, Mode=OneWay}" FontFamily="Segoe UI Semibold"/>
                </StackPanel>
            </Border>
            <DataGrid Grid.Row="2" ItemsSource="{Binding InstanceRuns, Mode=OneWay}" SelectedItem="{Binding SelectedInstanceRun}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Index" Binding="{Binding Index, Mode=OneWay}" Width="55"/>
                    <DataGridTextColumn Header="Nhóm" Binding="{Binding LaunchGroupDisplay, Mode=OneWay}" Width="78"/>
                    <DataGridTextColumn Header="Giả lập" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Kịch bản" Binding="{Binding ScriptName, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText, Mode=OneWay}" Width="125"/>
                    <DataGridTextColumn Header="Bước" Binding="{Binding CurrentStep, Mode=OneWay}" Width="*"/>
                    <DataGridTemplateColumn Header="Thao tác" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Dừng" Command="{Binding StopCommand}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
