<UserControl x:Class="MEmuScriptStudio.App.Views.RunControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MEmuScriptStudio.App.Views">
    <UserControl.Resources>
        <views:BindingProxy x:Key="RunControlDataContext" Data="{Binding}" />
        <Style x:Key="RuntimeCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <DataTemplate x:Key="ScriptComboItemTemplate">
            <TextBlock Text="{Binding DisplayNameWithKind, Mode=OneWay}" ToolTip="{Binding DisplayNameWithKind, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="RunControlColumns" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="520" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="RunSetupColumn">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Thiết lập chạy" Style="{StaticResource SectionTitleStyle}" />
                        <RadioButton Content="Một kịch bản cho tất cả" IsChecked="{Binding IsOneScriptForAll}" GroupName="CenterAssignment" Margin="0,10,0,6" />
                        <RadioButton Content="Mỗi giả lập một kịch bản" IsChecked="{Binding IsPerInstanceScript}" GroupName="CenterAssignment" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding IsOneScriptForAll, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Kịch bản dùng chung" FontWeight="SemiBold" />
                            <ComboBox x:Name="CommonScriptComboBox" ItemsSource="{Binding Scripts}" SelectedItem="{Binding CommonRunScript, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource ScriptComboItemTemplate}" Margin="0,5,0,0" Height="34"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                      AutomationProperties.Name="Kịch bản dùng chung" />
                        </StackPanel>
                        <TextBlock Text="{Binding RunConfigurationError}" Foreground="{StaticResource ErrorInkBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Làm mới" Command="{Binding RefreshCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" Height="34" Margin="8,0,0,0" />
                        <TextBlock Text="Giả lập mục tiêu" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RunTargetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Padding="10,6" VerticalContentAlignment="Center"
                                 ToolTip="Tìm theo tên hoặc index" AutomationProperties.Name="Tìm giả lập theo tên hoặc index" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding RunTargetAvailabilityFilters}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedRunTargetAvailabilityFilter, Mode=TwoWay}"
                                  MinWidth="112" Height="34" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Lọc trạng thái giả lập" />
                        <ComboBox Grid.Column="4" ItemsSource="{Binding RunTargetSortOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedRunTargetSortMode, Mode=TwoWay}"
                                  MinWidth="92" Height="34" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Sắp xếp giả lập" />
                    </Grid>

                    <DataGrid x:Name="RunTargetsGrid" Grid.Row="2" ItemsSource="{Binding FilteredRunTargets}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeight="36" ColumnHeaderHeight="34"
                              SelectionMode="Extended" SelectionUnit="FullRow" ScrollViewer.CanContentScroll="True"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseLeftButtonDown="RunTargetsGrid_PreviewMouseLeftButtonDown"
                              AutomationProperties.Name="Danh sách chọn giả lập chạy">
                        <DataGrid.Resources>
                            <Style x:Key="RunTargetCellTextStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Padding" Value="6,0" />
                            </Style>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource SelectedInkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chọn" Width="Auto" MinWidth="50" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsEnabled="{Binding CanSelectForRun}"
                                                  AutomationProperties.Name="Chọn giả lập" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index, Mode=OneWay}" Width="Auto" MinWidth="62"
                                                ElementStyle="{StaticResource RunTargetCellTextStyle}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Tên instance" Width="2*" MinWidth="130" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Style="{StaticResource RunTargetCellTextStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="Auto" MinWidth="92" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AvailabilityText}" ToolTip="{Binding AvailabilityText}"
                                                   Foreground="{StaticResource MutedBrush}" Style="{StaticResource RunTargetCellTextStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="AssignmentColumn" Header="Kịch bản được gán" Width="2*" MinWidth="150"
                                                    Visibility="{Binding Data.IsPerInstanceScript, Source={StaticResource RunControlDataContext}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AssignedScriptDisplay}" ToolTip="{Binding AssignedScriptDisplay}"
                                                   Style="{StaticResource RunTargetCellTextStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Scripts, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  ItemTemplate="{StaticResource ScriptComboItemTemplate}" SelectedValuePath="Id"
                                                  SelectedValue="{Binding AssignedScriptId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="34" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                  AutomationProperties.Name="Kịch bản riêng của giả lập" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Chọn tất cả đang lọc" Command="{Binding SelectAllFilteredRunTargetsCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" Height="34" Margin="0" />
                        <Button Grid.Column="1" Content="Bỏ chọn tất cả" Command="{Binding ClearRunTargetSelectionCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" Height="34" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding RunTargetSelectionSummary}" VerticalAlignment="Center"
                                   ToolTip="{Binding RunTargetSelectionSummary}" TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" Margin="12,0,0,0" TextAlignment="Right" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                    Visibility="{Binding IsPerInstanceScript, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="150" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ControlCenterScriptComboBox" ItemsSource="{Binding Scripts}"
                                      SelectedItem="{Binding ControlCenterSelectedScript, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource ScriptComboItemTemplate}" Height="34"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                      AutomationProperties.Name="Kịch bản gán hàng loạt" />
                            <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                <Button x:Name="AssignScriptToSelectedButton" Content="Gán cho mục đã chọn"
                                        Command="{Binding AssignScriptToSelectedCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                        Height="34" Margin="0,0,6,0" />
                                <Button x:Name="AssignSelectedScriptToAllButton" Content="Gán kịch bản đang chọn cho tất cả"
                                        Command="{Binding AssignCurrentScriptToAllCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                        Height="34" Margin="0" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LaunchSpacingCard" Grid.Row="4" Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Khoảng cách khởi chạy trong nhóm" FontWeight="SemiBold" />
                    <WrapPanel x:Name="LaunchSpacingOptions" Grid.Row="1" Margin="0,6,0,0">
                        <RadioButton Content="Cố định (ms)" IsChecked="{Binding IsFixedSpacing}" GroupName="CenterSpacing"
                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox MinWidth="86" Height="34" Padding="10,6" VerticalContentAlignment="Center"
                                 Text="{Binding FixedSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsFixedSpacing}" />
                        <RadioButton Content="Ngẫu nhiên (ms)" IsChecked="{Binding IsRandomSpacing}" GroupName="CenterSpacing"
                                     Margin="16,0,8,0" VerticalAlignment="Center" />
                        <TextBox MinWidth="74" Height="34" Padding="10,6" VerticalContentAlignment="Center"
                                 Text="{Binding RandomMinimumSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRandomSpacing}" />
                        <TextBlock Text="–" Margin="6,8" />
                        <TextBox MinWidth="74" Height="34" Padding="10,6" VerticalContentAlignment="Center"
                                 Text="{Binding RandomMaximumSpacingMilliseconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRandomSpacing}" />
                    </WrapPanel>
                    <CheckBox Grid.Row="2" Content="Dừng cả nhóm nếu có giả lập không hợp lệ"
                              IsChecked="{Binding StopAllOnInvalidTarget}" Margin="0,8,0,0" />
                    <WrapPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Left">
                        <Button x:Name="RunSelectedButton" Content="Chạy mục đã chọn" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="RunAllRemainingButton" Content="Chạy tất cả còn lại" Command="{Binding RunAllRemainingCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource GroupCardStyle}">
                <WrapPanel VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,4"><TextBlock><Run Text="Đang chạy: " /><Run Text="{Binding RunningInstanceCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                    <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,4"><TextBlock><Run Text="Đang chờ: " /><Run Text="{Binding WaitingInstanceCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                    <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,0,4"><TextBlock><Run Text="Tổng active: " /><Run Text="{Binding ActiveInstanceRuns.Count, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                </WrapPanel>
            </Border>

            <Border x:Name="LatestRunResultCard" Grid.Row="2" Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Xóa kết quả" Command="{Binding ClearLatestRunResultCommand}"
                                Style="{StaticResource DangerButtonStyle}" />
                        <TextBlock Text="Kết quả lần chạy gần nhất" ToolTip="Kết quả lần chạy gần nhất"
                                   Style="{StaticResource SectionTitleStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0" Text="Chưa có nhóm chạy nào hoàn tất trong phiên này."
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding HasNoLatestRunResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasLatestRunResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding LatestRunResult.RunDescription}">
                            <Run Text="{Binding LatestRunResult.RunDescription, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,12,4">
                                <Run Text="Bắt đầu  " /><Run Text="{Binding LatestRunResult.StartedAt, Mode=OneWay, StringFormat={}{0:g}}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,12,4">
                                <Run Text="Kết thúc  " /><Run Text="{Binding LatestRunResult.EndedAt, Mode=OneWay, StringFormat={}{0:g}}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4">
                                <Run Text="Thời lượng  " /><Run Text="{Binding LatestRunResult.DurationText, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </WrapPanel>
                        <WrapPanel Margin="0,2,0,0" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,4"><TextBlock TextAlignment="Center"><Run Text="Tổng: " /><Run Text="{Binding LatestRunResult.TotalInstanceCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                            <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,4"><TextBlock TextAlignment="Center"><Run Text="Thành công: " /><Run Text="{Binding LatestRunResult.SucceededCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                            <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,4"><TextBlock TextAlignment="Center"><Run Text="Thất bại: " /><Run Text="{Binding LatestRunResult.FailedCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                            <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,0,4"><TextBlock TextAlignment="Center"><Run Text="Đã hủy: " /><Run Text="{Binding LatestRunResult.CancelledCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                        </WrapPanel>
                        <TextBlock x:Name="LatestRunNoIssuesText" Text="Không có instance thất bại hoặc bị hủy."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding LatestRunResult.HasNoIssues, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <DataGrid x:Name="LatestRunIssuesGrid" ItemsSource="{Binding LatestRunResult.IssueInstances}" Margin="0,6,0,0" MaxHeight="150"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  Visibility="{Binding LatestRunResult.HasIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="Auto" MinWidth="56" ElementStyle="{StaticResource RuntimeCellTextStyle}" />
                                <DataGridTemplateColumn Header="Giả lập" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding InstanceName}" ToolTip="{Binding InstanceName}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Kịch bản" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ScriptName}" ToolTip="{Binding ScriptName}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bước cuối" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LastStep}" ToolTip="{Binding LastStep}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trạng thái" Width="Auto" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" TextAlignment="Center" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Thông báo" Width="2*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ErrorMessage}" ToolTip="{Binding ErrorMessage}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button x:Name="StopSelectedActiveButton" Content="Dừng các mục đã chọn"
                                    Command="{Binding StopSelectedActiveInstancesCommand}" Style="{StaticResource DangerButtonStyle}" />
                            <Button x:Name="StopAllActiveButton" Content="Dừng tất cả"
                                    Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0" />
                        </WrapPanel>
                        <TextBlock Text="Đang hoạt động" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="ActiveInstancesGrid" Grid.Row="2" ItemsSource="{Binding ActiveInstanceRuns}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="36" ColumnHeaderHeight="34"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True"
                              EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseLeftButtonDown="ActiveInstancesGrid_PreviewMouseLeftButtonDown"
                              AutomationProperties.Name="Danh sách giả lập đang hoạt động">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource SelectedInkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chọn" Width="Auto" MinWidth="50">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanStop}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index, Mode=OneWay}" Width="Auto" MinWidth="56" ElementStyle="{StaticResource RuntimeCellTextStyle}" />
                            <DataGridTemplateColumn Header="Tên instance" Width="2*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name, Mode=OneWay}" ToolTip="{Binding Name, Mode=OneWay}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Kịch bản" Width="2*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ScriptName, Mode=OneWay}" ToolTip="{Binding ScriptName, Mode=OneWay}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Bước hiện tại" Width="2*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CurrentStep, Mode=OneWay}" ToolTip="{Binding CurrentStep, Mode=OneWay}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="Auto" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText, Mode=OneWay}" ToolTip="{Binding StatusText, Mode=OneWay}" TextAlignment="Center" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Dừng" Width="Auto" MinWidth="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Dừng" Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="30" Padding="10,4" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ActiveInstancesEmptyState" Grid.Row="2" Text="Chưa có giả lập nào đang hoạt động."
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveInstanceRuns.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
