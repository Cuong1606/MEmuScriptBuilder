<UserControl x:Class="MEmuScriptStudio.App.Views.RunControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MEmuScriptStudio.App.Controls"
             xmlns:views="clr-namespace:MEmuScriptStudio.App.Views">
    <UserControl.Resources>
        <views:BindingProxy x:Key="RunControlDataContext" Data="{Binding}" />
        <Style x:Key="RuntimeCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <DataTemplate x:Key="ScriptComboItemTemplate">
            <TextBlock Text="{Binding DisplayNameWithKind, Mode=OneWay}" ToolTip="{Binding DisplayNameWithKind, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <Style x:Key="ControlCenterSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SharedFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="2" CornerRadius="1" Background="{StaticResource BorderBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,8" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RunControlColumns" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RunSetupColumnDefinition" Width="3*" MinWidth="360" />
            <ColumnDefinition x:Name="RunSplitterColumnDefinition" Width="8" />
            <ColumnDefinition x:Name="RunRuntimeColumnDefinition" Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="RunSetupColumn">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="RunSetupCard" Style="{StaticResource GroupCardStyle}">
                <Expander x:Name="RunSetupExpander" Header="Thiết lập chạy" IsExpanded="True">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <RadioButton Content="Một kịch bản cho tất cả" IsChecked="{Binding IsOneScriptForAll}" GroupName="CenterAssignment" Margin="0,0,0,6" />
                        <RadioButton Content="Mỗi giả lập một kịch bản" IsChecked="{Binding IsPerInstanceScript}" GroupName="CenterAssignment" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding IsOneScriptForAll, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Kịch bản dùng chung" FontWeight="SemiBold" />
                            <ComboBox x:Name="CommonScriptComboBox" ItemsSource="{Binding Scripts}" SelectedItem="{Binding CommonRunScript, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource ScriptComboItemTemplate}" Margin="0,5,0,0" Height="34"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                      AutomationProperties.Name="Kịch bản dùng chung" />
                        </StackPanel>
                        <Grid Visibility="{Binding IsPerInstanceScript, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="ControlCenterScriptComboBox" ItemsSource="{Binding Scripts}"
                                      SelectedItem="{Binding ControlCenterSelectedScript, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource ScriptComboItemTemplate}" Height="34"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                      AutomationProperties.Name="Kịch bản gán hàng loạt" />
                            <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                <Button x:Name="AssignScriptToSelectedButton" Content="Gán cho mục đã chọn"
                                        Command="{Binding AssignScriptToSelectedCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                        Height="34" Margin="0,0,6,0" />
                                <Button x:Name="AssignSelectedScriptToAllButton" Content="Gán kịch bản đang chọn cho tất cả"
                                        Command="{Binding AssignCurrentScriptToAllCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                        Height="34" Margin="0" />
                            </WrapPanel>
                        </Grid>
                        <TextBlock Text="{Binding RunConfigurationError}" Foreground="{StaticResource ErrorInkBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
                </Expander>
            </Border>

            <Border x:Name="RunTargetsCard" Grid.Row="2" Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Làm mới" Command="{Binding RefreshCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" Height="30" Margin="8,0,0,0" />
                        <TextBlock Text="Giả lập mục tiêu" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RunTargetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Padding="10,4" VerticalContentAlignment="Center"
                                 ToolTip="Tìm theo tên hoặc index" AutomationProperties.Name="Tìm giả lập theo tên hoặc index" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding RunTargetAvailabilityFilters}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedRunTargetAvailabilityFilter, Mode=TwoWay}"
                                  MinWidth="112" Height="30" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Lọc trạng thái giả lập" />
                        <ComboBox Grid.Column="4" ItemsSource="{Binding RunTargetSortOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedRunTargetSortMode, Mode=TwoWay}"
                                  MinWidth="92" Height="30" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Sắp xếp giả lập" />
                    </Grid>

                    <DataGrid x:Name="RunTargetsGrid" Grid.Row="2" ItemsSource="{Binding FilteredRunTargets}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeight="36" ColumnHeaderHeight="34"
                              SelectionMode="Extended" SelectionUnit="FullRow" ScrollViewer.CanContentScroll="True"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseLeftButtonDown="RunTargetsGrid_PreviewMouseLeftButtonDown"
                              AutomationProperties.Name="Danh sách chọn giả lập chạy">
                        <DataGrid.Resources>
                            <Style x:Key="RunTargetCellTextStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Padding" Value="6,0" />
                            </Style>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource SelectedInkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chọn" Width="Auto" MinWidth="50" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsEnabled="{Binding CanSelectForRun}"
                                                  AutomationProperties.Name="Chọn giả lập" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index, Mode=OneWay}" Width="Auto" MinWidth="62"
                                                ElementStyle="{StaticResource RunTargetCellTextStyle}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Tên instance" Width="2*" MinWidth="130" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Style="{StaticResource RunTargetCellTextStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="Auto" MinWidth="92" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AvailabilityText}" ToolTip="{Binding AvailabilityText}"
                                                   Foreground="{StaticResource MutedBrush}" Style="{StaticResource RunTargetCellTextStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="AssignmentColumn" Header="Kịch bản được gán" Width="2*" MinWidth="150"
                                                    Visibility="{Binding Data.IsPerInstanceScript, Source={StaticResource RunControlDataContext}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AssignedScriptDisplay}" ToolTip="{Binding AssignedScriptDisplay}"
                                                   Style="{StaticResource RunTargetCellTextStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Scripts, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  ItemTemplate="{StaticResource ScriptComboItemTemplate}" SelectedValuePath="Id"
                                                  SelectedValue="{Binding AssignedScriptId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="34" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                  AutomationProperties.Name="Kịch bản riêng của giả lập" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Chọn tất cả đang lọc" Command="{Binding SelectAllFilteredRunTargetsCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" Height="30" Margin="0" />
                        <Button Grid.Column="1" Content="Bỏ chọn tất cả" Command="{Binding ClearRunTargetSelectionCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" Height="30" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding RunTargetSelectionSummary}" VerticalAlignment="Center"
                                   ToolTip="{Binding RunTargetSelectionSummary}" TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" Margin="12,0,0,0" TextAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LaunchSpacingCard" Grid.Row="4" Style="{StaticResource GroupCardStyle}">
                <Expander x:Name="LaunchSpacingExpander" Header="Khoảng cách khởi chạy trong nhóm" IsExpanded="True">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Content="Dừng cả nhóm nếu có giả lập không hợp lệ"
                              IsChecked="{Binding StopAllOnInvalidTarget}" HorizontalAlignment="Left" />
                    <Grid x:Name="LaunchSpacingOptions" Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Top">
                            <RadioButton Content="Cố định" IsChecked="{Binding IsFixedSpacing}" GroupName="CenterSpacing"
                                         VerticalAlignment="Center" />
                            <RadioButton Content="Ngẫu nhiên" IsChecked="{Binding IsRandomSpacing}" GroupName="CenterSpacing"
                                         VerticalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <controls:DurationInputControl x:Name="FixedSpacingInput"
                                                           TotalMilliseconds="{Binding FixedSpacingMilliseconds, Mode=TwoWay}"
                                                           IsInputValid="{Binding IsFixedSpacingInputValid, Mode=OneWayToSource}"
                                                           IsEnabled="{Binding IsFixedSpacing}"
                                                           Visibility="{Binding IsFixedSpacing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Visibility="{Binding IsRandomSpacing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Từ" VerticalAlignment="Center" />
                                    <controls:DurationInputControl x:Name="RandomMinimumSpacingInput" Grid.Column="1"
                                                                   TotalMilliseconds="{Binding RandomMinimumSpacingMilliseconds, Mode=TwoWay}"
                                                                   IsInputValid="{Binding IsRandomMinimumSpacingInputValid, Mode=OneWayToSource}"
                                                                   IsEnabled="{Binding IsRandomSpacing}" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Đến" VerticalAlignment="Center" />
                                    <controls:DurationInputControl x:Name="RandomMaximumSpacingInput" Grid.Column="1"
                                                                   TotalMilliseconds="{Binding RandomMaximumSpacingMilliseconds, Mode=TwoWay}"
                                                                   IsInputValid="{Binding IsRandomMaximumSpacingInputValid, Mode=OneWayToSource}"
                                                                   IsEnabled="{Binding IsRandomSpacing}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Button x:Name="RunSelectedButton" Content="Chạy mục đã chọn" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="RunAllRemainingButton" Content="Chạy tất cả còn lại" Command="{Binding RunAllRemainingCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </Grid>
                </Expander>
            </Border>
        </Grid>

        <GridSplitter x:Name="RunSetupRuntimeSplitter" Grid.Column="1" Width="8"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeWE"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                      Style="{StaticResource ControlCenterSplitterStyle}"
                      MouseDoubleClick="RunSetupRuntimeSplitter_MouseDoubleClick"
                      AutomationProperties.Name="Điều chỉnh chiều rộng thiết lập chạy và theo dõi" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="ControlCenterStatusMessage" Text="{Binding StatusMessage, Mode=OneWay}"
                               ToolTip="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                               MaxHeight="40" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,4"><TextBlock><Run Text="Đang chạy: " /><Run Text="{Binding RunningInstanceCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                        <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,4"><TextBlock><Run Text="Đang chờ: " /><Run Text="{Binding WaitingInstanceCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                        <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,0,4"><TextBlock><Run Text="Tổng active: " /><Run Text="{Binding ActiveInstanceRuns.Count, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button x:Name="StopSelectedActiveButton" Content="Dừng các mục đã chọn"
                                    Command="{Binding StopSelectedActiveInstancesCommand}" Style="{StaticResource DangerButtonStyle}" />
                            <Button x:Name="StopAllActiveButton" Content="Dừng tất cả"
                                    Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0" />
                        </WrapPanel>
                        <TextBlock Text="Đang hoạt động" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ActiveInstanceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Padding="10,6" VerticalContentAlignment="Center"
                                 ToolTip="Tìm theo index, tên giả lập hoặc tên kịch bản"
                                 AutomationProperties.Name="Tìm giả lập đang hoạt động" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ActiveInstanceFilters}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedActiveInstanceFilter, Mode=TwoWay}"
                                  MinWidth="118" Height="34" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Lọc giả lập đang hoạt động" />
                    </Grid>
                    <DataGrid x:Name="ActiveInstancesGrid" Grid.Row="4" ItemsSource="{Binding FilteredActiveInstanceRuns}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="36" ColumnHeaderHeight="34"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseLeftButtonDown="ActiveInstancesGrid_PreviewMouseLeftButtonDown"
                              AutomationProperties.Name="Danh sách giả lập đang hoạt động">
                        <DataGrid.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:DataGridColumnExtentRowsPresenter />
                            </ItemsPanelTemplate>
                        </DataGrid.ItemsPanel>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource SelectedInkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chọn" Width="Auto" MinWidth="50" MaxWidth="64">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanStop}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index, Mode=OneWay}" Width="Auto" MinWidth="56" MaxWidth="72" ElementStyle="{StaticResource RuntimeCellTextStyle}" />
                            <DataGridTemplateColumn Header="Tên instance" Width="*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name, Mode=OneWay}" ToolTip="{Binding Name, Mode=OneWay}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Kịch bản" Width="*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ScriptName, Mode=OneWay}" ToolTip="{Binding ScriptName, Mode=OneWay}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Bước hiện tại" Width="*" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CurrentStep, Mode=OneWay}" ToolTip="{Binding CurrentStep, Mode=OneWay}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="Auto" MinWidth="110" MaxWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText, Mode=OneWay}" ToolTip="{Binding StatusText, Mode=OneWay}" TextAlignment="Center" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Thông báo" Width="2*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MessageText, Mode=OneWay}" ToolTip="{Binding MessageText, Mode=OneWay}" Style="{StaticResource RuntimeCellTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Dừng" Width="Auto" MinWidth="76" MaxWidth="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Dừng" Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="30" Padding="10,4" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ActiveInstancesEmptyState" Grid.Row="4" Text="Chưa có giả lập đang hoạt động."
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoActiveInstances}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="ActiveInstancesFilterEmptyState" Grid.Row="4"
                               Text="Không có giả lập phù hợp tìm kiếm hoặc bộ lọc."
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveInstancesButNoFilteredMatches}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
