<Window x:Class="MEmuScriptStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MEmuScriptStudio.App.Controls"
        xmlns:behaviors="clr-namespace:MEmuScriptStudio.App.Behaviors"
        Title="MEmu Script Studio" Width="1280" Height="760" MinWidth="1100" MinHeight="680"
        Icon="Assets/AppIcon.ico"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        behaviors:BackgroundFocusBehavior.IsEnabled="True"
        behaviors:BackgroundFocusBehavior.HasValidationErrors="{Binding HasEditorBindingErrors, Mode=OneWayToSource}">
    <Window.Resources>
        <Style x:Key="MainWindowSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SharedFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="2" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Background="{StaticResource BorderBrush}" CornerRadius="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="WorkspaceRoot" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource GroupCardStyle}" Padding="12">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Thiết bị soạn thảo" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="InstanceComboBox" ItemsSource="{Binding EditorTargets}"
                                  SelectedItem="{Binding SelectedEditorTarget}" IsEnabled="{Binding CanSelectEditorTarget}"
                                  Height="34" Padding="10,5" Margin="0"
                                  VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="Thiết bị soạn thảo dùng để xem trước và lấy tọa độ">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Details}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding AvailabilityText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="RefreshInstancesButton" Grid.Column="2" Content="Làm mới" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" Height="34" Padding="12,6" Margin="0" VerticalAlignment="Center" />
                    <Button x:Name="DeviceSettingsButton" Grid.Column="4" Content="Kết nối / Cài đặt thiết bị"
                            Click="DeviceSettingsButton_Click" LostMouseCapture="PopupToggleButton_LostMouseCapture"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="34" Padding="12,6" Margin="0" VerticalAlignment="Center"
                            AutomationProperties.Name="Mở cài đặt kết nối và thiết bị" />
                    <Button x:Name="OpenControlCenterButton" Grid.Column="6" Content="Mở Trung tâm điều khiển" Click="OpenControlCenter_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="12,6" Margin="0" VerticalAlignment="Center" />
                    <Popup x:Name="DeviceSettingsPopup" PlacementTarget="{Binding ElementName=DeviceSettingsButton}"
                           Placement="Bottom" HorizontalOffset="0" VerticalOffset="4" StaysOpen="False"
                           AllowsTransparency="True" DataContext="{Binding}" Closed="DeviceSettingsPopup_Closed">
                        <Border x:Name="DeviceSettingsPopupContent" Style="{StaticResource GroupCardStyle}" Padding="16"
                                PreviewKeyDown="DeviceSettingsPopupContent_PreviewKeyDown">
                            <Grid Width="440">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Kết nối / Cài đặt thiết bị" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Grid.Row="2" Text="Đường dẫn memuc.exe" />
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="MemucPathField" Height="34" Padding="10,6" VerticalAlignment="Center"
                                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="3" ToolTip="{Binding MemucPath, Mode=OneWay}"
                                            AutomationProperties.Name="Đường dẫn memuc.exe">
                                        <TextBlock x:Name="MemucPathTextBlock" Text="{Binding MemucPath, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Border>
                                    <Button x:Name="BrowseMemucButton" Grid.Column="2" Content="Chọn…" Command="{Binding BrowseCommand}"
                                            Click="CloseDeviceSettingsPopup_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="12,6"
                                            Margin="0" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Grid.Row="6" Text="Đường dẫn adb.exe" />
                                <Grid Grid.Row="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AdbPath, Mode=OneWay}" IsReadOnly="True"
                                             ToolTip="{Binding AdbPath, Mode=OneWay}"
                                             AutomationProperties.Name="Đường dẫn adb.exe" />
                                    <Button Grid.Column="2" Content="Chọn…" Command="{Binding BrowseAdbCommand}"
                                            Click="CloseDeviceSettingsPopup_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="34" />
                                </Grid>
                                <DockPanel Grid.Row="10" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Đổi tên Android…"
                                            Command="{Binding EditAndroidDeviceAliasCommand}"
                                            Click="CloseDeviceSettingsPopup_Click"
                                            Visibility="{Binding ShowAndroidDeviceAliasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource ToolbarButtonStyle}" Height="34" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding AdbConnectionStatus, Mode=OneWay}"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Grid x:Name="EditorLayoutGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LibraryPaneColumn" Width="5*" MinWidth="240" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition x:Name="StepsPaneColumn" Width="8*" MinWidth="340" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition x:Name="PropertiesPaneColumn" Width="7*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GroupCardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Thư viện kịch bản" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ScriptLibrarySelectionSummary, Mode=OneWay}"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <Button x:Name="ScriptLibraryMoreButton" Grid.Column="2" Content="…"
                                    Click="ScriptLibraryMoreButton_Click" LostMouseCapture="PopupToggleButton_LostMouseCapture"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    MinWidth="34" Height="34" Padding="8,4" Margin="0"
                                    ToolTip="Thao tác khác" AutomationProperties.Name="Thao tác khác với thư viện kịch bản" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tìm" VerticalAlignment="Center" />
                            <TextBox x:Name="ScriptLibrarySearchTextBox" Grid.Column="2"
                                     Text="{Binding ScriptLibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tìm theo tên kịch bản" AutomationProperties.Name="Tìm theo tên kịch bản" />
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ScriptLibraryFilters}" SelectedItem="{Binding ScriptLibraryFilter}"
                                      ToolTip="Lọc loại kịch bản" AutomationProperties.Name="Lọc loại kịch bản">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ScriptLibraryFilterDisplayConverter}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox x:Name="ScriptLibrarySortComboBox" Grid.Column="2"
                                      ItemsSource="{Binding ScriptLibrarySortOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SelectedScriptLibrarySortMode, Mode=TwoWay}"
                                      ToolTip="Sắp xếp thư viện" AutomationProperties.Name="Sắp xếp thư viện kịch bản" />
                        </Grid>
                        <Grid Grid.Row="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="ScriptLibraryColumnsHeader" Background="{StaticResource PanelBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="128" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ScriptNameColumnHeader" Text="Tên" Margin="11,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ScriptKindColumnHeader" Grid.Column="1" Text="Loại" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="ScriptUpdatedColumnHeader" Grid.Column="2" Text="Cập nhật" Margin="11,0" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="ScriptsList" Grid.Row="1" ItemsSource="{Binding ScriptLibraryView}"
                                 SelectionMode="Extended" SelectionChanged="ScriptsList_SelectionChanged"
                                 AllowDrop="{Binding CanReorderScriptLibrary, Mode=OneWay}"
                                 PreviewMouseLeftButtonDown="ScriptsList_PreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="ScriptsList_PreviewMouseLeftButtonUp"
                                 LostMouseCapture="ScriptsList_LostMouseCapture"
                                 PreviewMouseMove="ScriptsList_PreviewMouseMove"
                                 DragOver="ScriptsList_DragOver" DragLeave="ScriptsList_DragLeave" Drop="ScriptsList_Drop"
                                 IsEnabled="{Binding CanChangeSelection}" AutomationProperties.Name="Danh sách kịch bản"
                                 ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Height" Value="36" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="128" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="11,0" Text="{Binding Name}" ToolTip="{Binding Name}"
                                                   VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding KindText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Grid.Column="2" Margin="11,0" Text="{Binding UpdatedAt}" Style="{StaticResource MutedTextStyle}"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1" Text="Chưa có kịch bản phù hợp. Hãy tạo mới hoặc đổi bộ lọc."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ScriptsList, Path=Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Row="8">
                            <TextBlock x:Name="ScriptNameLabel" Text="Tên kịch bản" Margin="0,0,0,4" />
                            <TextBox x:Name="ScriptNameTextBox" Text="{Binding ScriptName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Tên kịch bản" />
                        </StackPanel>
                        <WrapPanel Grid.Row="10">
                            <Button Content="Tạo thường" Command="{Binding CreateScriptCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Tạo kịch bản thường" />
                            <Button Content="Tạo gộp" Command="{Binding CreateCompositeScriptCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Tạo kịch bản gộp" />
                            <Button x:Name="RenameScriptButton" Content="Đổi tên" Command="{Binding RenameScriptCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Đổi tên kịch bản (F2, Enter để lưu, Esc để hủy)" />
                            <Button Content="Xóa" Command="{Binding DeleteScriptCommand}" Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="Xóa kịch bản đã chọn (Delete)" />
                        </WrapPanel>
                        <Popup x:Name="ScriptLibraryMorePopup" PlacementTarget="{Binding ElementName=ScriptLibraryMoreButton}"
                               Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                               DataContext="{Binding}" Closed="ScriptLibraryMorePopup_Closed">
                            <Border x:Name="ScriptLibraryMorePopupContent" Style="{StaticResource GroupCardStyle}" Padding="8"
                                    PreviewKeyDown="ScriptLibraryMorePopupContent_PreviewKeyDown">
                                <StackPanel Width="176">
                                    <Button Content="Nhân bản" Command="{Binding DuplicateScriptCommand}"
                                            Click="CloseScriptLibraryMorePopup_Click" Style="{StaticResource ToolbarButtonStyle}"
                                            HorizontalContentAlignment="Left" Margin="0,0,0,4" ToolTip="Ctrl+D" />
                                    <Button Content="Nhập…" Command="{Binding ImportScriptsCommand}"
                                            Click="CloseScriptLibraryMorePopup_Click" Style="{StaticResource ToolbarButtonStyle}"
                                            HorizontalContentAlignment="Left" Margin="0,0,0,4" />
                                    <Button Content="Xuất kịch bản chọn…" Command="{Binding ExportSelectedScriptCommand}"
                                            Click="CloseScriptLibraryMorePopup_Click" Style="{StaticResource ToolbarButtonStyle}"
                                            HorizontalContentAlignment="Left" Margin="0,0,0,4" />
                                    <Button Content="Xuất tất cả…" Command="{Binding ExportAllScriptsCommand}"
                                            Click="CloseScriptLibraryMorePopup_Click" Style="{StaticResource ToolbarButtonStyle}"
                                            HorizontalContentAlignment="Left" Margin="0" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <GridSplitter x:Name="LibraryEditorSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                              Cursor="SizeWE" Style="{StaticResource MainWindowSplitterStyle}"
                              MouseDoubleClick="EditorSplitter_MouseDoubleClick" />

                <Border Grid.Column="2" Style="{StaticResource GroupCardStyle}" Padding="12">
                    <Grid>
                    <Grid Visibility="{Binding IsRegularScriptSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="StepsHeaderGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepsHeaderTitle" Text="Các bước" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="StepClipboardStatus" Grid.Column="2" Text="{Binding StepClipboardSummary, Mode=OneWay}"
                                       ToolTip="{Binding StepClipboardSummary, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <DataGrid x:Name="StepsGrid" Grid.Row="2" ItemsSource="{Binding Steps}"
                                  SelectedItem="{Binding SelectedStep, Mode=OneWay}" IsEnabled="{Binding CanChangeSelection}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                   SelectionMode="Extended" SelectionUnit="FullRow" AllowDrop="True" RowHeight="36"
                                   ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   ScrollViewer.IsDeferredScrollingEnabled="False"
                                   ScrollViewer.HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="StepsGrid_SelectionChanged"
                                  PreviewMouseLeftButtonDown="StepsGrid_PreviewMouseLeftButtonDown"
                                  MouseDoubleClick="StepsGrid_MouseDoubleClick"
                                  PreviewMouseMove="StepsGrid_PreviewMouseMove"
                                  DragOver="StepsGrid_DragOver" DragLeave="StepsGrid_DragLeave" Drop="StepsGrid_Drop"
                                  AutomationProperties.Name="Danh sách bước kịch bản">
                            <DataGrid.Resources>
                                <Style x:Key="StepLeftHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="11,5" />
                                </Style>
                                <Style x:Key="StepCenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="StepLeftCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="StepCenteredCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="StepTextStyle" TargetType="TextBlock">
                                    <Setter Property="Padding" Value="11,0" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tên" Width="*" IsReadOnly="True"
                                                        HeaderStyle="{StaticResource StepLeftHeaderStyle}"
                                                        CellStyle="{StaticResource StepLeftCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" ToolTip="{Binding DisplayName, Mode=OneWay}"
                                                       Style="{StaticResource StepTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Kind, Mode=OneWay, Converter={StaticResource ScriptStepKindDisplayConverter}}"
                                                    Width="Auto" MinWidth="120" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource StepLeftHeaderStyle}"
                                                    CellStyle="{StaticResource StepLeftCellStyle}"
                                                    ElementStyle="{StaticResource StepTextStyle}" />
                                <DataGridTemplateColumn Header="Bật" Width="Auto" MinWidth="46"
                                                        HeaderStyle="{StaticResource StepCenteredHeaderStyle}"
                                                        CellStyle="{StaticResource StepCenteredCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Kịch bản chưa có bước. Chọn “Thêm” để bắt đầu."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Steps.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel x:Name="StepActionBar" Grid.Row="4">
                            <Button Content="Thêm" Command="{Binding NewStepCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Thêm bước mới" />
                            <Button Content="Nhân bản" Command="{Binding DuplicateStepCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Nhân bản bước đã chọn" />
                            <Button x:Name="DeleteStepsButton" Content="Xóa" Command="{Binding DeleteStepCommand}" Style="{StaticResource DangerButtonStyle}" ToolTip="Xóa bước đã chọn (Delete)" />
                            <Button x:Name="CopyStepsButton" Content="Sao chép" Command="{Binding CopyStepsCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Sao chép (Ctrl+C)" />
                            <Button x:Name="PasteStepsButton" Content="Dán" Command="{Binding PasteStepsCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Dán (Ctrl+V)" />
                            <Button x:Name="UndoStepsButton" Content="Hoàn tác" Command="{Binding UndoStepListCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Hoàn tác (Ctrl+Z)" />
                            <Button Content="↑" Command="{Binding MoveStepUpCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Di chuyển bước lên" />
                            <Button Content="↓" Command="{Binding MoveStepDownCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Di chuyển bước xuống" />
                        </WrapPanel>
                    </Grid>
                    <Grid Visibility="{Binding IsCompositeScriptSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Các mục gộp" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Grid.Column="2" Text="{Binding CompositeClipboardSummary, Mode=OneWay}"
                                       ToolTip="{Binding CompositeClipboardSummary, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <DataGrid x:Name="CompositeItemsGrid" Grid.Row="2" ItemsSource="{Binding CompositeItems}"
                                  SelectedItem="{Binding SelectedCompositeItem, Mode=OneWay}" IsEnabled="{Binding CanChangeSelection}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow" AllowDrop="True" RowHeight="36"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.IsDeferredScrollingEnabled="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="CompositeItemsGrid_SelectionChanged"
                                  PreviewMouseLeftButtonDown="CompositeItemsGrid_PreviewMouseLeftButtonDown"
                                  MouseDoubleClick="CompositeItemsGrid_MouseDoubleClick"
                                  PreviewMouseMove="CompositeItemsGrid_PreviewMouseMove"
                                  DragOver="CompositeItemsGrid_DragOver" DragLeave="CompositeItemsGrid_DragLeave"
                                  Drop="CompositeItemsGrid_Drop"
                                  AutomationProperties.Name="Danh sách mục kịch bản gộp">
                            <DataGrid.Resources>
                                <Style x:Key="CompositeLeftHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="11,5" />
                                </Style>
                                <Style x:Key="CompositeCenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="CompositeLeftCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="CompositeCenteredCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="CompositeTextStyle" TargetType="TextBlock">
                                    <Setter Property="Padding" Value="11,0" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loại" Binding="{Binding KindText, Mode=OneWay}" Width="140" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource CompositeLeftHeaderStyle}"
                                                    CellStyle="{StaticResource CompositeLeftCellStyle}"
                                                    ElementStyle="{StaticResource CompositeTextStyle}" />
                                <DataGridTemplateColumn Header="Nội dung" Width="*" IsReadOnly="True"
                                                        HeaderStyle="{StaticResource CompositeLeftHeaderStyle}"
                                                        CellStyle="{StaticResource CompositeLeftCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description, Mode=OneWay}" ToolTip="{Binding Description, Mode=OneWay}"
                                                       Style="{StaticResource CompositeTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bật" Width="56"
                                                        HeaderStyle="{StaticResource CompositeCenteredHeaderStyle}"
                                                        CellStyle="{StaticResource CompositeCenteredCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      PreviewMouseLeftButtonDown="CompositeEnabledCheckBox_PreviewMouseLeftButtonDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Kịch bản gộp chưa có mục. Hãy thêm kịch bản hoặc thời gian chờ."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CompositeItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid x:Name="CompositeActionBar" Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button Grid.Column="0" Content="Thêm kịch bản" Command="{Binding AddCompositeReferenceCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="1" Content="Thêm chờ" Command="{Binding AddCompositeDelayCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2" Content="Xóa" Command="{Binding DeleteCompositeItemsCommand}" Style="{StaticResource DangerButtonStyle}" />
                            <Button Grid.Column="3" Content="Sao chép" Command="{Binding CopyCompositeItemsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Grid.Row="1" Grid.Column="0" Content="Dán" Command="{Binding PasteCompositeItemsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Hoàn tác" Command="{Binding UndoCompositeItemsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="↑" Command="{Binding MoveCompositeItemUpCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Di chuyển mục gộp lên" />
                            <Button Grid.Row="1" Grid.Column="3" Content="↓" Command="{Binding MoveCompositeItemDownCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Di chuyển mục gộp xuống" />
                        </Grid>
                    </Grid>
                    </Grid>
                </Border>

                <GridSplitter x:Name="StepsPropertiesSplitter" Grid.Column="3" Width="8" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                              Cursor="SizeWE" Style="{StaticResource MainWindowSplitterStyle}"
                              MouseDoubleClick="EditorSplitter_MouseDoubleClick" />

                <Border x:Name="StepPropertiesPanel" Grid.Column="4" Style="{StaticResource GroupCardStyle}" Padding="12" IsEnabled="{Binding CanChangeSelection}">
                    <Grid>
                    <Grid x:Name="RegularStepPropertiesPanel" Visibility="{Binding IsRegularScriptSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" />
                            <RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Thuộc tính bước" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Grid.Row="2" Text="Chọn một bước để xem và chỉnh thuộc tính."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Visibility="{Binding ShowRegularEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowRegularStepEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Loại bước" />
                                <ComboBox ItemsSource="{Binding StepKinds}" SelectedItem="{Binding EditorKind}" Margin="0,4,0,8">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ScriptStepKindDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Visibility="{Binding ShowStepName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Tên bước" />
                                    <TextBox x:Name="EditorNameTextBox" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                </StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="Bật bước" IsChecked="{Binding EditorIsEnabled}" Margin="0,0,18,0"
                                              Visibility="{Binding IsStepEditorCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="Bật bước" IsChecked="{Binding SelectedStep.IsEnabled}" Margin="0,0,18,0"
                                              Visibility="{Binding IsStepEditorEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="Tiếp tục nếu lỗi" IsChecked="{Binding EditorContinueOnError}"
                                              Visibility="{Binding ShowContinueOnError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </WrapPanel>
                                <StackPanel Visibility="{Binding ShowTimeout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Thời gian tối đa (giây)" /><TextBox x:Name="EditorTimeoutTextBox" Text="{Binding EditorTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowPackageName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Tên ứng dụng" />
                                    <Border x:Name="ApplicationDisplayNameField" Margin="0,4,0,8" Padding="10,7"
                                            MinHeight="34" Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                            AutomationProperties.Name="Tên ứng dụng đã chọn">
                                        <TextBlock Text="{Binding EditorApplicationDisplayText, Mode=OneWay}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Tên gói ứng dụng" />
                                    <Grid x:Name="ApplicationPickerRow" Margin="0,4,0,8" Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PackageNameTextBox" Grid.Column="0" Height="34"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 Text="{Binding EditorPackageName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button x:Name="SelectApplicationButton" Grid.Column="2" Height="34" MinWidth="116" VerticalAlignment="Center"
                                                Content="Chọn ứng dụng…" Command="{Binding SelectApplicationCommand}"
                                                Style="{StaticResource ToolbarButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowActivityName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Tên Activity" /><TextBox Text="{Binding EditorActivityName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowDelay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Thời gian chờ" />
                                    <controls:DurationInputControl x:Name="EditorDelayInput" Margin="0,4,0,8"
                                                                   TotalMilliseconds="{Binding EditorDelayMilliseconds, Mode=TwoWay}"
                                                                   RefreshToken="{Binding EditorDelayInputRefreshToken, Mode=OneWay}"
                                                                   IsInputValid="{Binding IsEditorDelayInputValid, Mode=OneWayToSource}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowTap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Điểm chạm (X, Y)" />
                                    <WrapPanel Margin="0,4,0,8"><TextBox Width="90" Text="{Binding EditorX, UpdateSourceTrigger=PropertyChanged}" /><TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY, UpdateSourceTrigger=PropertyChanged}" /></WrapPanel>
                                    <Button Content="Lấy tọa độ" Command="{Binding CaptureTapCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowHold, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Điểm nhấn giữ (X, Y)" />
                                    <WrapPanel Margin="0,4,0,8"><TextBox Width="90" Text="{Binding EditorX, UpdateSourceTrigger=PropertyChanged}" /><TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY, UpdateSourceTrigger=PropertyChanged}" /></WrapPanel>
                                    <TextBlock Text="Thời gian giữ (ms)" /><TextBox Text="{Binding EditorHoldDuration, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                    <Button Content="Chọn tọa độ nhấn giữ" Command="{Binding CaptureHoldCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowSwipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Điểm bắt đầu (X1, Y1)" />
                                    <WrapPanel Margin="0,4,0,8"><TextBox Width="90" Text="{Binding EditorX, UpdateSourceTrigger=PropertyChanged}" /><TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY, UpdateSourceTrigger=PropertyChanged}" /></WrapPanel>
                                    <TextBlock Text="Điểm kết thúc (X2, Y2)" />
                                    <WrapPanel Margin="0,4,0,8"><TextBox Width="90" Text="{Binding EditorX2, UpdateSourceTrigger=PropertyChanged}" /><TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY2, UpdateSourceTrigger=PropertyChanged}" /></WrapPanel>
                                    <TextBlock Text="Thời gian vuốt (ms)" /><TextBox Text="{Binding EditorSwipeDuration, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                    <Button Content="Chọn đường vuốt" Command="{Binding CaptureSwipeCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowInputText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Văn bản nhập" /><TextBox x:Name="EditorInputTextBox" Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" AcceptsReturn="True" MinHeight="55" />
                                    <CheckBox x:Name="PressEnterAfterInputCheckBox" Content="Nhấn Enter sau khi nhập" IsChecked="{Binding EditorPressEnterAfterInput}" Margin="0,0,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowAndroidClipboardPaste, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Dán clipboard hiện có trong Android; ứng dụng không đọc clipboard Windows." TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <CheckBox Content="Nhấn Enter sau khi dán" IsChecked="{Binding EditorPressEnterAfterPaste}" Margin="0,0,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowKeyEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Phím Android" />
                                    <ComboBox ItemsSource="{Binding KeyEvents}" SelectedItem="{Binding EditorKey}" Margin="0,4,0,8">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource AndroidKeyEventDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Border Padding="10" Margin="0,0,0,8" Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Visibility="{Binding ShowAndroidShell, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel><TextBlock Text="Lệnh Android shell" /><TextBox Text="{Binding EditorCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" /><TextBlock Text="Cảnh báo: chỉ chạy lệnh shell bạn tin cậy." Foreground="{StaticResource WarningInkBrush}" /></StackPanel>
                                </Border>
                                <StackPanel Visibility="{Binding ShowNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Nội dung ghi chú" /><TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" AcceptsReturn="True" MinHeight="80" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <DockPanel Grid.Row="4" LastChildFill="False">
                            <Button x:Name="SaveStepButton" Content="Lưu bước" Command="{Binding SaveStepCommand}"
                                    Visibility="{Binding ShowRegularSaveButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowRegularAddButtons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button x:Name="AddStepButton" Content="Thêm bước" Command="{Binding AddStepCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button x:Name="CancelStepCreateButton" Content="Hủy" Command="{Binding CancelStepCreateCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <Button x:Name="TestStepButton" Content="Chạy thử bước" Command="{Binding TestStepCommand}"
                                    DockPanel.Dock="Right"
                                    PreviewMouseLeftButtonDown="TestStepButton_PreviewMouseLeftButtonDown"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Chạy bước hiện tại trên thiết bị soạn thảo mà không lưu thay đổi"
                                    AutomationProperties.Name="Chạy thử bước hiện tại" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TestStepFeedback, Mode=OneWay}"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,0,8,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                        <StackPanel Grid.Row="6">
                            <Expander Header="Xem trước lệnh" IsExpanded="True">
                                <TextBox x:Name="CommandPreviewTextBox" Margin="0,4,0,0" Text="{Binding CommandPreview, Mode=OneWay}"
                                         ToolTip="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
                            </Expander>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CompositePropertiesPanel" Visibility="{Binding IsCompositeScriptSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" />
                            <RowDefinition Height="8" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Thuộc tính mục gộp" Style="{StaticResource SectionTitleStyle}" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Kịch bản gộp chỉ chứa tham chiếu kịch bản thường và mục Chờ."
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                                <StackPanel Visibility="{Binding SelectedCompositeItem.IsReference, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Kịch bản thường" />
                                    <ComboBox ItemsSource="{Binding RegularScripts}" SelectedItem="{Binding CompositeReferenceScript}"
                                              DisplayMemberPath="Name" Margin="0,4,0,8" />
                                    <CheckBox Content="Tiếp tục nếu kịch bản này lỗi" IsChecked="{Binding CompositeContinueOnFailure}" Margin="0,0,0,8" />
                                    <Button Content="Mở kịch bản" Command="{Binding OpenReferencedScriptCommand}"
                                            Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding SelectedCompositeItem.IsDelay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Thời gian chờ" />
                                    <controls:DurationInputControl x:Name="CompositeDelayInput" Margin="0,4,0,8"
                                                                   TotalMilliseconds="{Binding CompositeDelayMilliseconds, Mode=TwoWay}"
                                                                   RefreshToken="{Binding CompositeDelayInputRefreshToken, Mode=OneWay}"
                                                                   IsInputValid="{Binding IsCompositeDelayInputValid, Mode=OneWayToSource}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="SaveCompositeItemButton" Grid.Row="4" Content="Lưu mục" Command="{Binding SaveCompositeItemCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                    </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="MainStatusBar" Grid.Row="4" Style="{StaticResource GroupCardStyle}" Padding="10">
                <DockPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,0"><TextBlock Text="{Binding MemucConnectionStatus, Mode=OneWay}" /></Border>
                        <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,0"><TextBlock Text="{Binding EditorSaveState, Mode=OneWay}" /></Border>
                        <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock><Run Text="Đang hoạt động  " /><Run Text="{Binding ActiveInstanceRuns.Count, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                    </WrapPanel>
                </DockPanel>
            </Border>
            <TextBlock Grid.Row="5" Margin="4,8,4,0" Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>

    </Grid>
</Window>
