<Window x:Class="MEmuScriptStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEmu Script Studio" Width="1280" Height="760" MinWidth="1100" MinHeight="680"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid x:Name="WorkspaceRoot" Margin="16" IsEnabled="{Binding CanUseApplication}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource GroupCardStyle}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MemucPathTextBox" Text="{Binding MemucPath, Mode=OneWay}" IsReadOnly="True"
                             AutomationProperties.Name="Đường dẫn memuc.exe" />
                    <Button Grid.Column="2" Content="Chọn memuc.exe…" Command="{Binding BrowseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                              IsEnabled="{Binding CanChangeSelection}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Giả lập dùng để xem trước và lấy tọa độ" />
                    <Button Grid.Column="6" Content="Làm mới" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="OpenControlCenterButton" Grid.Column="8" Content="Mở Trung tâm điều khiển" Click="OpenControlCenter_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" MinWidth="240" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="420" MinWidth="350" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="350" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GroupCardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Kịch bản" FontSize="18" FontWeight="SemiBold" />
                        <ListBox x:Name="ScriptsList" Grid.Row="2" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                                 DisplayMemberPath="Name" IsEnabled="{Binding CanChangeSelection}"
                                 AutomationProperties.Name="Danh sách kịch bản" />
                        <TextBox Grid.Row="4" Text="{Binding ScriptName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Tên kịch bản" />
                        <WrapPanel Grid.Row="6">
                            <Button Content="Tạo" Command="{Binding CreateScriptCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Đổi tên" Command="{Binding RenameScriptCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Nhân bản" Command="{Binding DuplicateScriptCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Xóa" Command="{Binding DeleteScriptCommand}" Style="{StaticResource DangerButtonStyle}" />
                            <Button Content="Nhập…" Command="{Binding ImportScriptsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="Xuất chọn…" Command="{Binding ExportSelectedScriptCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="Xuất tất cả…" Command="{Binding ExportAllScriptsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="2" Style="{StaticResource GroupCardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="Các bước" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                                <Run Text="Đã sao chép: " /><Run Text="{Binding CopiedStepCount, Mode=OneWay}" /><Run Text=" bước" />
                            </TextBlock>
                        </DockPanel>
                        <DataGrid x:Name="StepsGrid" Grid.Row="2" ItemsSource="{Binding Steps}"
                                  SelectedItem="{Binding SelectedStep, Mode=OneWay}" IsEnabled="{Binding CanChangeSelection}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow" AllowDrop="True"
                                  SelectionChanged="StepsGrid_SelectionChanged"
                                  PreviewMouseLeftButtonDown="StepsGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="StepsGrid_PreviewMouseMove"
                                  DragOver="StepsGrid_DragOver" DragLeave="StepsGrid_DragLeave" Drop="StepsGrid_Drop"
                                  PreviewKeyDown="StepsGrid_PreviewKeyDown"
                                  AutomationProperties.Name="Danh sách bước kịch bản">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên" Binding="{Binding Name, Mode=OneWay}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Loại" Binding="{Binding Kind, Mode=OneWay, Converter={StaticResource ScriptStepKindDisplayConverter}}" Width="145" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Bật" Width="46">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText, Mode=OneWay}" Width="84" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="4">
                            <Button Content="Thêm" Command="{Binding NewStepCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Nhân bản" Command="{Binding DuplicateStepCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Xóa" Command="{Binding DeleteStepCommand}" Style="{StaticResource DangerButtonStyle}" />
                            <Button x:Name="CopyStepsButton" Content="Sao chép" Command="{Binding CopyStepsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button x:Name="PasteStepsButton" Content="Dán" Command="{Binding PasteStepsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="Hoàn tác" Command="{Binding UndoStepListCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="↑" Command="{Binding MoveStepUpCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Di chuyển bước lên" />
                            <Button Content="↓" Command="{Binding MoveStepDownCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Di chuyển bước xuống" />
                        </WrapPanel>
                        <TextBlock Grid.Row="5" Margin="2,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                            <Run Text="Ctrl+C/Ctrl+V hoạt động khi danh sách bước có focus. Nguồn: " />
                            <Run Text="{Binding CopiedFromScriptName, Mode=OneWay, TargetNullValue=chưa có}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="4" Style="{StaticResource GroupCardStyle}" Padding="12" IsEnabled="{Binding CanChangeSelection}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" />
                            <RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Thuộc tính bước" FontSize="18" FontWeight="SemiBold" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Loại bước" />
                                <ComboBox ItemsSource="{Binding StepKinds}" SelectedItem="{Binding EditorKind}" Margin="0,4,0,8">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ScriptStepKindDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Tên bước" />
                                <TextBox x:Name="EditorNameTextBox" Text="{Binding EditorName}" Margin="0,4,0,8" />
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="Bật bước" IsChecked="{Binding EditorIsEnabled}" Margin="0,0,18,0" />
                                    <CheckBox Content="Tiếp tục nếu lỗi" IsChecked="{Binding EditorContinueOnError}"
                                              Visibility="{Binding ShowContinueOnError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </WrapPanel>
                                <StackPanel Visibility="{Binding ShowTimeout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Thời gian tối đa (giây)" /><TextBox Text="{Binding EditorTimeoutSeconds}" Margin="0,4,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowPackageName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Tên gói ứng dụng" />
                                    <DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Right" Content="Chọn ứng dụng…" Command="{Binding SelectApplicationCommand}" Style="{StaticResource ToolbarButtonStyle}" /><TextBox Text="{Binding EditorPackageName}" /></DockPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowActivityName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Tên Activity" /><TextBox Text="{Binding EditorActivityName}" Margin="0,4,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowDelay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Thời gian chờ (ms)" /><TextBox Text="{Binding EditorDelayMilliseconds}" Margin="0,4,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowTap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Điểm chạm (X, Y)" />
                                    <WrapPanel Margin="0,4,0,8"><TextBox Width="90" Text="{Binding EditorX}" /><TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY}" /></WrapPanel>
                                    <Button Content="Lấy tọa độ" Command="{Binding CaptureTapCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowHold, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Điểm nhấn giữ (X, Y)" />
                                    <WrapPanel Margin="0,4,0,8"><TextBox Width="90" Text="{Binding EditorX}" /><TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY}" /></WrapPanel>
                                    <TextBlock Text="Thời gian giữ (ms)" /><TextBox Text="{Binding EditorHoldDuration}" Margin="0,4,0,8" />
                                    <Button Content="Chọn tọa độ nhấn giữ" Command="{Binding CaptureHoldCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowSwipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Điểm bắt đầu (X1, Y1)" />
                                    <WrapPanel Margin="0,4,0,8"><TextBox Width="90" Text="{Binding EditorX}" /><TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY}" /></WrapPanel>
                                    <TextBlock Text="Điểm kết thúc (X2, Y2)" />
                                    <WrapPanel Margin="0,4,0,8"><TextBox Width="90" Text="{Binding EditorX2}" /><TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY2}" /></WrapPanel>
                                    <TextBlock Text="Thời gian vuốt (ms)" /><TextBox Text="{Binding EditorSwipeDuration}" Margin="0,4,0,8" />
                                    <Button Content="Chọn đường vuốt" Command="{Binding CaptureSwipeCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowInputText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Văn bản nhập" /><TextBox Text="{Binding EditorText}" Margin="0,4,0,8" AcceptsReturn="True" MinHeight="55" />
                                    <CheckBox x:Name="PressEnterAfterInputCheckBox" Content="Nhấn Enter sau khi nhập" IsChecked="{Binding EditorPressEnterAfterInput}" Margin="0,0,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowAndroidClipboardPaste, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Dán clipboard hiện có trong Android; ứng dụng không đọc clipboard Windows." TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <CheckBox Content="Nhấn Enter sau khi dán" IsChecked="{Binding EditorPressEnterAfterPaste}" Margin="0,0,0,8" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowKeyEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Phím Android" />
                                    <ComboBox ItemsSource="{Binding KeyEvents}" SelectedItem="{Binding EditorKey}" Margin="0,4,0,8">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource AndroidKeyEventDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Border Padding="10" Margin="0,0,0,8" Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Visibility="{Binding ShowAndroidShell, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel><TextBlock Text="Lệnh Android shell" /><TextBox Text="{Binding EditorCommand}" Margin="0,4,0,8" /><TextBlock Text="Cảnh báo: chỉ chạy lệnh shell bạn tin cậy." Foreground="{StaticResource WarningInkBrush}" /></StackPanel>
                                </Border>
                                <StackPanel Visibility="{Binding ShowNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Nội dung ghi chú" /><TextBox Text="{Binding EditorText}" Margin="0,4,0,8" AcceptsReturn="True" MinHeight="80" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <DockPanel Grid.Row="4">
                            <Button Content="Lưu bước" Command="{Binding SaveStepCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding EditorSaveState}" />
                        </DockPanel>
                        <StackPanel Grid.Row="6">
                            <TextBlock Text="Xem trước lệnh" FontWeight="SemiBold" />
                            <TextBox x:Name="CommandPreviewTextBox" Margin="0,4,0,0" Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="MainStatusBar" Grid.Row="4" Style="{StaticResource GroupCardStyle}" Padding="10">
                <DockPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock><Run Text="Đang chạy  " /><Run Text="{Binding RunningInstanceCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock></Border>
                        <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock><Run Text="Chờ khởi chạy  " /><Run Text="{Binding WaitingInstanceCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock></Border>
                        <Border Style="{StaticResource StatusBadgeStyle}"><TextBlock><Run Text="Thất bại gần nhất  " /><Run Text="{Binding FailedInstanceCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock></Border>
                    </WrapPanel>
                </DockPanel>
            </Border>
            <TextBlock Grid.Row="5" Margin="4,8,4,0" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <Border x:Name="InitializationOverlay" Panel.ZIndex="10" Background="#EAF4F7FA"
                Visibility="{Binding IsStartupOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <ProgressBar Height="6" Margin="0,0,0,20" IsIndeterminate="True"
                                 Visibility="{Binding IsInitializing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StartupTitle}" FontWeight="SemiBold" FontSize="22" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
