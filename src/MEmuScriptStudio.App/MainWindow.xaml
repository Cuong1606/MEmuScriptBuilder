<Window x:Class="MEmuScriptStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEmu Script Studio" Width="1280" Height="720" MinWidth="1100" MinHeight="680"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="130" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MemucPathTextBox" Text="{Binding MemucPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Đường dẫn memuc.exe" />
                <Button Grid.Column="2" Content="Chọn memuc.exe…" Command="{Binding BrowseCommand}" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" IsEnabled="{Binding CanChangeSelection}"
                          DisplayMemberPath="Name" MinHeight="38" Padding="8" AutomationProperties.Name="Instance MEmu" />
                <Button Grid.Column="6" Content="Làm mới" Command="{Binding RefreshCommand}" />
                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button Content="Run" Command="{Binding RunCommand}" Background="{StaticResource AccentBrush}" Foreground="White" MinWidth="72" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0" MinWidth="72" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="400" MinWidth="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Kịch bản" FontFamily="Segoe UI Semibold" FontSize="18" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}" DisplayMemberPath="Name" IsEnabled="{Binding CanChangeSelection}"
                             AutomationProperties.Name="Danh sách kịch bản" />
                    <TextBox Grid.Row="4" Text="{Binding ScriptName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tên kịch bản" />
                    <WrapPanel Grid.Row="6">
                        <Button Content="Tạo" Command="{Binding CreateScriptCommand}" Margin="0,0,6,6" />
                        <Button Content="Đổi tên" Command="{Binding RenameScriptCommand}" Margin="0,0,6,6" />
                        <Button Content="Nhân bản" Command="{Binding DuplicateScriptCommand}" Margin="0,0,6,6" />
                        <Button Content="Xóa" Command="{Binding DeleteScriptCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Padding="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Các bước" FontFamily="Segoe UI Semibold" FontSize="18" />
                    <DataGrid x:Name="StepsGrid" Grid.Row="2" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" AutoGenerateColumns="False" IsEnabled="{Binding CanChangeSelection}"
                              IsReadOnly="False" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" AllowDrop="True"
                              SelectionChanged="StepsGrid_SelectionChanged"
                              PreviewMouseLeftButtonDown="StepsGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="StepsGrid_PreviewMouseMove"
                              DragOver="StepsGrid_DragOver" DragLeave="StepsGrid_DragLeave" Drop="StepsGrid_Drop"
                              PreviewKeyDown="StepsGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name, Mode=OneWay}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Loại" Binding="{Binding Kind, Mode=OneWay, Converter={StaticResource ScriptStepKindDisplayConverter}}" Width="135" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Bật" Width="45" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Bật bước" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText, Mode=OneWay}" Width="88" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="4">
                        <Button Content="Thêm" Command="{Binding NewStepCommand}" Margin="0,0,6,0" />
                        <Button Content="Nhân bản" Command="{Binding DuplicateStepCommand}" Margin="0,0,6,0" />
                        <Button Content="Xóa" Command="{Binding DeleteStepCommand}" Margin="0,0,6,0" />
                        <Button Content="↑" Command="{Binding MoveStepUpCommand}" Margin="0,0,6,0" AutomationProperties.Name="Di chuyển bước lên" />
                        <Button Content="↓" Command="{Binding MoveStepDownCommand}" AutomationProperties.Name="Di chuyển bước xuống" />
                    </WrapPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="4" Padding="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" IsEnabled="{Binding CanChangeSelection}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Thuộc tính bước" FontFamily="Segoe UI Semibold" FontSize="18" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Loại bước" />
                            <ComboBox ItemsSource="{Binding StepKinds}" SelectedItem="{Binding EditorKind}" MinHeight="34" Margin="0,4,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ScriptStepKindDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Tên bước" />
                            <TextBox Text="{Binding EditorName}" Margin="0,4,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox Content="Bật bước" IsChecked="{Binding EditorIsEnabled}" Margin="0,0,18,0" />
                                <CheckBox Content="Tiếp tục nếu lỗi" IsChecked="{Binding EditorContinueOnError}"
                                          Visibility="{Binding ShowContinueOnError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                            <StackPanel Visibility="{Binding ShowTimeout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Thời gian tối đa (giây)" />
                                <TextBox Text="{Binding EditorTimeoutSeconds}" Margin="0,4,0,8" AutomationProperties.Name="Thời gian tối đa" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowPackageName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Tên gói ứng dụng" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EditorPackageName}" AutomationProperties.Name="Tên gói ứng dụng" />
                                    <Button Grid.Column="2" Content="Chọn ứng dụng…" Command="{Binding SelectApplicationCommand}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowActivityName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Tên Activity" />
                                <TextBox Text="{Binding EditorActivityName}" Margin="0,4,0,8" AutomationProperties.Name="Tên Activity" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowDelay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Thời gian chờ (ms)" />
                                <TextBox Text="{Binding EditorDelayMilliseconds}" Margin="0,4,0,8" AutomationProperties.Name="Thời gian chờ" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowTap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Điểm chạm (X, Y)" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBox Width="90" Text="{Binding EditorX}" AutomationProperties.Name="Tọa độ X" />
                                    <TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY}" AutomationProperties.Name="Tọa độ Y" />
                                </StackPanel>
                                <Button Content="Lấy tọa độ" Command="{Binding CaptureTapCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowSwipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Điểm bắt đầu (X1, Y1)" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBox Width="90" Text="{Binding EditorX}" AutomationProperties.Name="Tọa độ X1" />
                                    <TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY}" AutomationProperties.Name="Tọa độ Y1" />
                                </StackPanel>
                                <TextBlock Text="Điểm kết thúc (X2, Y2)" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBox Width="90" Text="{Binding EditorX2}" AutomationProperties.Name="Tọa độ X2" />
                                    <TextBox Width="90" Margin="8,0,0,0" Text="{Binding EditorY2}" AutomationProperties.Name="Tọa độ Y2" />
                                </StackPanel>
                                <TextBlock Text="Thời gian vuốt (ms)" />
                                <TextBox Text="{Binding EditorSwipeDuration}" Margin="0,4,0,8" AutomationProperties.Name="Thời gian vuốt" />
                                <Button Content="Chọn đường vuốt" Command="{Binding CaptureSwipeCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowInputText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Văn bản nhập" />
                                <TextBox Text="{Binding EditorText}" Margin="0,4,0,8" AcceptsReturn="True" MinHeight="55" AutomationProperties.Name="Văn bản nhập" />
                                <CheckBox x:Name="PressEnterAfterInputCheckBox"
                                          Content="Nhấn Enter sau khi nhập"
                                          IsChecked="{Binding EditorPressEnterAfterInput}"
                                          AutomationProperties.Name="Nhấn Enter sau khi nhập"
                                          Margin="0,0,0,8" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowKeyEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Phím Android" />
                                <ComboBox ItemsSource="{Binding KeyEvents}" SelectedItem="{Binding EditorKey}" MinHeight="34" Margin="0,4,0,8" AutomationProperties.Name="Phím Android">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AndroidKeyEventDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Border Padding="10" Margin="0,0,0,8" Background="#FFF4E5" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding ShowAndroidShell, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Lệnh Android shell" />
                                    <TextBox Text="{Binding EditorCommand}" Margin="0,4,0,8" AutomationProperties.Name="Lệnh Android shell" />
                                    <TextBlock Text="Cảnh báo: Lệnh shell thô có thể thay đổi dữ liệu hoặc trạng thái của máy ảo. Chỉ chạy lệnh bạn tin cậy."
                                               TextWrapping="Wrap" Foreground="#92400E" />
                                </StackPanel>
                            </Border>
                            <StackPanel Visibility="{Binding ShowNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Nội dung ghi chú" />
                                <TextBox Text="{Binding EditorText}" Margin="0,4,0,8" AcceptsReturn="True" MinHeight="80" AutomationProperties.Name="Nội dung ghi chú" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="4" Content="Lưu bước" Command="{Binding SaveStepCommand}" HorizontalAlignment="Left"
                            Background="{StaticResource AccentBrush}" Foreground="White" />
                    <StackPanel Grid.Row="6">
                        <TextBlock Text="Xem trước lệnh" FontFamily="Segoe UI Semibold" />
                        <TextBox x:Name="CommandPreviewTextBox" Margin="0,4,0,0" Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Padding="10" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Execution log" Foreground="White" FontFamily="Segoe UI Semibold" />
                <ListBox Grid.Row="1" ItemsSource="{Binding ExecutionLog}" Background="#111827" Foreground="#E5E7EB" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Execution log" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Margin="4,8,4,0" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
