<Window x:Class="MEmuScriptStudio.App.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn ứng dụng" Width="680" Height="520" MinWidth="540" MinHeight="400"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tìm ứng dụng" />
            <Button Grid.Column="2" Content="Làm mới" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" />
            <Button Grid.Column="4" Content="Nhận ứng dụng đang mở" Click="Foreground_Click" IsEnabled="{Binding CanRefresh}" />
        </Grid>
        <DataGrid x:Name="ApplicationsGrid" Grid.Row="2" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  SelectionUnit="FullRow" ScrollViewer.CanContentScroll="True"
                  ScrollViewer.IsDeferredScrollingEnabled="False"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="Applications_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên ứng dụng" Binding="{Binding DisplayName, Mode=OneWay}" Width="2*" />
                <DataGridTextColumn Header="Tên gói ứng dụng" Binding="{Binding PackageName, Mode=OneWay}" Width="2*" />
                <DataGridTextColumn Header="Tên Activity" Binding="{Binding ActivityName, Mode=OneWay}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Tên hiển thị thủ công cho ứng dụng đã chọn" />
            <TextBox x:Name="ManualDisplayNameTextBox" Text="{Binding ManualDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"
                     AutomationProperties.Name="Tên hiển thị thủ công" />
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="SaveApplicationNameButton" Content="Lưu tên" Click="SaveName_Click"
                        IsEnabled="{Binding CanSaveName}" MinWidth="90" />
                <Button Content="Xóa tên đã lưu" Click="DeleteName_Click"
                        IsEnabled="{Binding CanDeleteSavedName}" Margin="8,0,0,0" MinWidth="120" />
                <Button Content="Nhập thư viện…" Click="ImportNames_Click"
                        IsEnabled="{Binding CanRefresh}" Margin="8,0,0,0" MinWidth="110" />
                <Button Content="Xuất thư viện…" Click="ExportNames_Click"
                        IsEnabled="{Binding CanRefresh}" Margin="8,0,0,0" MinWidth="110" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" IsCancel="True" MinWidth="90" />
            <Button Content="Chọn" Click="Select_Click" Margin="8,0,0,0" MinWidth="90" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
