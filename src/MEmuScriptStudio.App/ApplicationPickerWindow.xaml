<Window x:Class="MEmuScriptStudio.App.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn ứng dụng" Width="680" Height="520" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tìm ứng dụng" />
            <Button Grid.Column="2" Content="Làm mới" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" />
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="Applications_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên ứng dụng" Binding="{Binding DisplayName, Mode=OneWay}" Width="2*" />
                <DataGridTextColumn Header="Tên gói ứng dụng" Binding="{Binding PackageName, Mode=OneWay}" Width="2*" />
                <DataGridTextColumn Header="Tên Activity" Binding="{Binding ActivityName, Mode=OneWay}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" IsCancel="True" MinWidth="90" />
            <Button Content="Chọn" Click="Select_Click" Margin="8,0,0,0" MinWidth="90" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
